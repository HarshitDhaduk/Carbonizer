{
  "ci": {
    "collect": {
      "_comment_collect": "Phase 4.5 — Lighthouse CI. Hits the URLs through the same already-running frontend the Playwright suite uses; saves CI minutes by sharing the build.",
      "url": [
        "http://127.0.0.1:3100/",
        "http://127.0.0.1:3100/onboarding"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "preset": "desktop",
        "_skip_audit_comment": "uses-rel-preconnect: third-party (Google Fonts) noise unavoidable until we self-host; track separately.",
        "skipAudits": ["uses-rel-preconnect"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
