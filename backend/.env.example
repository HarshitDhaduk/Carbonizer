# Carbonizer backend configuration. Copy to .env and adjust.

# App
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS — the Next.js dev origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. When USE_DB=false the API serves seed/mock data and needs no Postgres,
# so `uvicorn app.main:app` runs out of the box. Flip to true once Postgres is up.
USE_DB=false
DATABASE_URL=postgresql+asyncpg://carbonizer:carbonizer@localhost:5432/carbonizer

# Demo credentials served by the seed layer (USE_DB=false)
DEMO_EMAIL=demo@carbonizer.app
DEMO_PASSWORD=demo12345
